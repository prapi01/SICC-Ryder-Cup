# Copy to .env (or export in your shell). All optional.

# Target app URL. PROD is default (only env with current code; DEV not synced with MAIN).
BASE_URL=https://sicc-ryder-cup.pages.dev

# Firestore project. Derived from hostname if unset:
#   staging/preview/localhost -> sicc-ryder-cup-dev, else sicc-ryder-cup
#FIREBASE_PROJECT=sicc-ryder-cup

# 1 → headed mode (Step Runner / debugging). Default headless.
#HEADED=1

# headless (default) | step (interactive Step Runner — Phase 2+)
#TEST_MODE=headless
